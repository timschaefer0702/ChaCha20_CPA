 271:.././simpleserial/simpleserial.c **** {
 272:.././simpleserial/simpleserial.c ****     uint8_t ncmds = num_commands & 0xFF;
 273:.././simpleserial/simpleserial.c ****     simpleserial_put('r', 0x01, &ncmds);
 274:.././simpleserial/simpleserial.c ****     return 0x00;
