  11:chacha20.c    **** static inline void u32t8le(uint32_t v, uint8_t p[4]) {
  12:chacha20.c    ****     p[0] = v & 0xff;
  13:chacha20.c    ****     p[1] = (v >> 8) & 0xff;
  14:chacha20.c    ****     p[2] = (v >> 16) & 0xff;
  15:chacha20.c    ****     p[3] = (v >> 24) & 0xff;
  16:chacha20.c    **** }
  17:chacha20.c    **** 
  18:chacha20.c    **** static inline uint32_t u8t32le(uint8_t p[4]) {
  19:chacha20.c    ****     uint32_t value = p[3];
  20:chacha20.c    **** 
  21:chacha20.c    ****     value = (value << 8) | p[2];
  22:chacha20.c    ****     value = (value << 8) | p[1];
  23:chacha20.c    ****     value = (value << 8) | p[0];
  24:chacha20.c    **** 
  25:chacha20.c    ****     return value;
  26:chacha20.c    **** }
