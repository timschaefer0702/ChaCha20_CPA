  72:chacha20.c    **** // https://tools.ietf.org/html/rfc7539#section-2.3
  73:chacha20.c    **** static void chacha20_init_state(uint32_t s[16], uint8_t key[32], uint32_t counter, uint8_t nonce[12
  74:chacha20.c    ****     int i;
  75:chacha20.c    **** 
  76:chacha20.c    ****     // refer: https://dxr.mozilla.org/mozilla-beta/source/security/nss/lib/freebl/chacha20.c
  77:chacha20.c    ****     // convert magic number to string: "expand 32-byte k"
  78:chacha20.c    ****     s[0] = 0x61707865;
  79:chacha20.c    ****     s[1] = 0x3320646e;
  80:chacha20.c    ****     s[2] = 0x79622d32;
  81:chacha20.c    ****     s[3] = 0x6b206574;
  82:chacha20.c    **** 
  83:chacha20.c    ****     for (i = 0; i < 8; i++) {
  84:chacha20.c    ****         s[4 + i] = u8t32le(key + i * 4);
  85:chacha20.c    ****     }
  86:chacha20.c    **** 
  87:chacha20.c    ****     s[12] = counter;
  88:chacha20.c    **** 
  89:chacha20.c    ****     for (i = 0; i < 3; i++) {
  90:chacha20.c    ****         s[13 + i] = u8t32le(nonce + i * 4);
  91:chacha20.c    ****     }
  92:chacha20.c    **** }
