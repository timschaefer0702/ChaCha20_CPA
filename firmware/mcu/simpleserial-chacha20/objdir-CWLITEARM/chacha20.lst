  28:chacha20.c    **** static inline uint32_t rotl32(uint32_t x, int n) {
  29:chacha20.c    ****     // http://blog.regehr.org/archives/1063
  30:chacha20.c    ****     return x << n | (x >> (-n & 31));
  31:chacha20.c    **** }
