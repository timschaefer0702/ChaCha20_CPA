  41:chacha20.c    **** static void chacha20_serialize(uint32_t in[16], uint8_t output[64]) {
  42:chacha20.c    ****     int i;
  43:chacha20.c    ****     for (i = 0; i < 16; i++) {
  44:chacha20.c    ****         u32t8le(in[i], output + (i << 2));
  45:chacha20.c    ****     }
  46:chacha20.c    **** }
  47:chacha20.c    **** 
  48:chacha20.c    **** static void chacha20_block(uint32_t in[16], uint8_t out[64], int num_rounds) {
  49:chacha20.c    ****     int i;
  50:chacha20.c    ****     uint32_t x[16];
  51:chacha20.c    **** 
  52:chacha20.c    ****     memcpy(x, in, sizeof(uint32_t) * 16);
  53:chacha20.c    **** 
  54:chacha20.c    ****     for (i = num_rounds; i > 0; i -= 2) {
  55:chacha20.c    ****         chacha20_quarterround(x, 0, 4,  8, 12);
  56:chacha20.c    ****         chacha20_quarterround(x, 1, 5,  9, 13);
  57:chacha20.c    ****         chacha20_quarterround(x, 2, 6, 10, 14);
  58:chacha20.c    ****         chacha20_quarterround(x, 3, 7, 11, 15);
  59:chacha20.c    ****         chacha20_quarterround(x, 0, 5, 10, 15);
  60:chacha20.c    ****         chacha20_quarterround(x, 1, 6, 11, 12);
  61:chacha20.c    ****         chacha20_quarterround(x, 2, 7,  8, 13);
  62:chacha20.c    ****         chacha20_quarterround(x, 3, 4,  9, 14);
  63:chacha20.c    ****     }
  64:chacha20.c    **** 
  65:chacha20.c    ****     for (i = 0; i < 16; i++) {
  66:chacha20.c    ****         x[i] += in[i];
  67:chacha20.c    ****     }
  68:chacha20.c    **** 
  69:chacha20.c    ****     chacha20_serialize(x, out);
  70:chacha20.c    **** }
